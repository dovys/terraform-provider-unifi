# test/hil/secrets.env — operator-specific HIL config. TEMPLATE.
#
# Copy to test/hil/secrets.env and fill in. The copy is GITIGNORED: it points at
# your live console and your password manager, neither of which belongs in this
# (eventually public) repo. run.sh / write.sh source it automatically. CI never
# reads it (the HIL tests are //go:build hil and run only from your workstation).
#
#   cp test/hil/secrets.env.example test/hil/secrets.env
#   $EDITOR test/hil/secrets.env

# Your UniFi OS console — the management address reachable from this workstation.
export UNIFI_HOST="https://<your-console-host>"
export UNIFI_ALLOW_INSECURE=true            # the controller serves a self-signed cert

# A LOCAL UniFi OS admin (username + password). NOT a Ubiquiti SSO/cloud account
# — those trip 2FA (HTTP 499) and the provider rejects them. Create a dedicated
# local admin for automation.
export UNIFI_USERNAME="<local-admin-username>"

# Supply the password however you like. Set it inline, or fetch it from your
# password manager so it never lands on disk. Use exactly ONE of:
#   export UNIFI_PASSWORD="…"
#   export UNIFI_PASSWORD="$(op item get <ITEM> --reveal --fields password --vault <VAULT>)"
#   export UNIFI_PASSWORD="$(security find-generic-password -s <KEYCHAIN-ITEM> -w)"
export UNIFI_PASSWORD=""

# --- write.sh (write-verification) extras -----------------------------------
# W0 dhcp_reservation test: an UNUSED IPv4 inside your default network's DHCP
# scope (varies per console — nothing else may claim it).
# export UNIFI_HIL_RESERVATION_IP="<unused-ip-in-your-dhcp-scope>"
#
# W1 firewall_rule test: override the rule index only if 4000 collides on your
# console (default is 4000).
# export UNIFI_HIL_FW_RULE_INDEX="4000"
