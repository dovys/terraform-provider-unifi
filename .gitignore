# Go
*.exe
*.test
*.out
/dist/
terraform-provider-unifi

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example*.tfvars
crash.log
override.tf
override.tf.json

# Local env / secrets
.env
*.local

# HIL operator config — your live console address + password-manager layout.
# Source for run.sh / write.sh; copied from test/hil/secrets.env.example. The
# .example template is committed; the filled-in secrets.env never is.
test/hil/secrets.env

# Live network snapshot — local acceptance fixture only (real MACs/IPs); never commit
unifi-inventory.json

# Reverse-engineering captures — raw API dumps (real MACs/IPs/secrets); never
# commit. Redact via scripts/redact-capture.py before sharing (docs/reverse-engineering.md).
/re-captures/

# Reverse-engineering scratch space — vendor binaries/firmware, decompiled
# source, notes, any RE working files. Dumping ground; never commit (both the
# dot and non-dot forms are covered).
/.re/
/re/

# Claude Code local working dir — track shared skills/commands, ignore the rest
# (worktrees, local settings, scratch).
.claude/*
!.claude/skills/
!.claude/commands/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
